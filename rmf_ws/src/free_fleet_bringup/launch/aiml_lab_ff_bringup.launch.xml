<?xml version='1.0' ?>
<!-- Launch file for free_fleet adapters in the AIML Lab with generated nav graphs -->
<launch>
  <arg name="server_uri" default="" description="The URI of the api server to transmit state and task information."/>

  <group>
    <include file="$(find-pkg-share free_fleet_adapter)/fleet_adapter.launch.xml">
      <arg name="use_sim_time" value="false"/>
       <!--TODO: Fix the path, replace with actual paths to files once package is created  -->
      <arg name="nav_graph_file" value="$(find-pkg-share system_rmf_bringup)/nav_graphs/graph_0.yaml" />
      <arg name="config_file" value="$(find-pkg-share free_fleet_bringup)/config/fleet/aiml_lab_multi_tb3_fleet.yaml"/>
      <arg name="server_uri" value="$(var server_uri)"/>
    </include>
  </group>
</launch>
